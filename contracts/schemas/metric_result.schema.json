{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactistream.dev/contracts/metric_result.schema.json",
  "title": "MetricResult",
  "description": "A deterministic, inspectable measurement with its definition version, window and contributing evidence.",
  "type": "object",
  "required": ["schema_version", "match_id", "metric_id", "kind", "definition_version", "status", "window", "inputs", "state_version"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "match_id": { "$ref": "common.schema.json#/$defs/MatchId" },
    "metric_id": { "$ref": "common.schema.json#/$defs/MetricId" },
    "kind": { "$ref": "common.schema.json#/$defs/MetricKind" },
    "definition_version": { "type": "string", "pattern": "^[a-z_]+\\.v[0-9]+$" },
    "status": { "enum": ["ok", "unavailable"] },
    "unavailable_reason": { "enum": ["insufficient_tracking", "missing_events", "not_applicable"] },
    "value": { "type": "number" },
    "unit": { "enum": ["m", "ratio", "per_min", "score_0_100", "count", "cosine"] },
    "components": {
      "description": "Named sub-values (e.g. before/after widths) exposed in Analyst mode.",
      "type": "object",
      "additionalProperties": { "type": "number" }
    },
    "subject_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/PlayerId" } },
    "window": {
      "type": "object",
      "required": ["start_ms", "end_ms"],
      "additionalProperties": false,
      "properties": {
        "start_ms": { "$ref": "common.schema.json#/$defs/Milliseconds" },
        "end_ms": { "$ref": "common.schema.json#/$defs/Milliseconds" }
      }
    },
    "inputs": {
      "type": "object",
      "required": ["event_ids", "frame_ids"],
      "additionalProperties": false,
      "properties": {
        "event_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/EventId" } },
        "frame_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/FrameId" } },
        "excluded_count": { "type": "integer", "minimum": 0 }
      }
    },
    "params": { "type": "object", "additionalProperties": { "type": "number" } },
    "limitation_key": { "type": "string", "description": "Key into the narrative catalog for the limitation text shown in the product." },
    "state_version": { "type": "integer", "minimum": 0 }
  },
  "if": { "properties": { "status": { "const": "ok" } } },
  "then": { "required": ["value", "unit"] },
  "else": { "required": ["unavailable_reason"], "not": { "required": ["value"] } }
}
