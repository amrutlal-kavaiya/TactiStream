{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactistream.dev/contracts/insight_packet.schema.json",
  "title": "InsightPacket",
  "description": "Machine-readable render instruction for one (mode, language) variant of one insight version. Never contains executable UI code.",
  "type": "object",
  "required": [
    "schema_version",
    "insight_id",
    "insight_version",
    "match_id",
    "moment_id",
    "state_version",
    "as_of_session_ms",
    "mode",
    "language",
    "source_kind",
    "claim_status",
    "title",
    "body",
    "evidence_ids",
    "claim_ids",
    "render",
    "expires_at_session_ms",
    "trace_id"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/SchemaVersion" },
    "insight_id": { "$ref": "common.schema.json#/$defs/InsightId" },
    "insight_version": { "type": "integer", "minimum": 1 },
    "match_id": { "$ref": "common.schema.json#/$defs/MatchId" },
    "moment_id": { "$ref": "common.schema.json#/$defs/MomentId" },
    "state_version": { "type": "integer", "minimum": 0 },
    "as_of_session_ms": { "$ref": "common.schema.json#/$defs/Milliseconds" },
    "mode": { "$ref": "common.schema.json#/$defs/ViewerMode" },
    "language": { "$ref": "common.schema.json#/$defs/Language" },
    "source_kind": { "$ref": "common.schema.json#/$defs/SourceKind" },
    "claim_status": { "$ref": "common.schema.json#/$defs/ClaimStatus" },
    "title": { "type": "string", "minLength": 1, "maxLength": 80 },
    "body": { "type": "string", "minLength": 1, "maxLength": 400 },
    "labels": {
      "type": "array",
      "items": { "enum": ["synthetic", "interpretation", "partial_tracking", "fallback"] }
    },
    "evidence_ids": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/EvidenceId" } },
    "claim_ids": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/ClaimId" } },
    "render": {
      "type": "object",
      "required": ["clock", "show_from_ms", "show_until_ms", "priority", "panel", "annotations"],
      "additionalProperties": false,
      "properties": {
        "clock": { "const": "session_clock_ms" },
        "show_from_ms": { "$ref": "common.schema.json#/$defs/Milliseconds" },
        "show_until_ms": { "$ref": "common.schema.json#/$defs/Milliseconds" },
        "priority": { "type": "integer", "minimum": 1, "maximum": 3 },
        "panel": { "enum": ["lower_third", "side_panel"] },
        "annotations": { "type": "array", "items": { "$ref": "common.schema.json#/$defs/AnnotationId" } },
        "replay_window": {
          "type": "object",
          "required": ["start_ms", "end_ms"],
          "properties": {
            "start_ms": { "$ref": "common.schema.json#/$defs/Milliseconds" },
            "end_ms": { "$ref": "common.schema.json#/$defs/Milliseconds" }
          }
        }
      }
    },
    "expires_at_session_ms": { "$ref": "common.schema.json#/$defs/Milliseconds" },
    "trace_id": { "$ref": "common.schema.json#/$defs/TraceId" }
  }
}
