{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tactistream.dev/contracts/common.schema.json",
  "title": "TactiStream common definitions",
  "$defs": {
    "SchemaVersion": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "Milliseconds": { "type": "integer", "minimum": 0 },
    "MatchId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,63}$" },
    "TeamId": { "enum": ["blue", "amber"] },
    "PlayerId": { "type": "string", "pattern": "^(blue|amber)-[0-9]{2}$" },
    "EventId": { "type": "string", "pattern": "^evt-[0-9]{4,}$" },
    "FrameId": { "type": "string", "pattern": "^frm-[0-9]{6,}$" },
    "MetricId": { "type": "string", "pattern": "^metric-[a-z_]+-[0-9]{4,}(-(blue|amber)-[0-9]{2})?$" },
    "MomentId": { "type": "string", "pattern": "^mom-[0-9]{4,}$" },
    "InsightId": { "type": "string", "pattern": "^ins-[0-9]{4,}$" },
    "ClaimId": { "type": "string", "pattern": "^clm-[0-9]{4,}-[0-9]+$" },
    "EvidenceId": {
      "anyOf": [
        { "$ref": "#/$defs/EventId" },
        { "$ref": "#/$defs/FrameId" },
        { "$ref": "#/$defs/MetricId" }
      ]
    },
    "TraceId": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "PointM": {
      "description": "Stadium-fixed position in metres; pitch 105 x 68, origin bottom-left.",
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -5, "maximum": 110 },
        { "type": "number", "minimum": -5, "maximum": 73 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "SourceKind": { "enum": ["synthetic", "event_feed_aligned_to_video", "video_derived"] },
    "Provenance": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "kind": { "$ref": "#/$defs/SourceKind" },
        "generator_version": { "type": "string" },
        "seed": { "type": "integer" }
      }
    },
    "ViewerMode": { "enum": ["fan", "analyst"] },
    "Language": { "enum": ["en", "hi"] },
    "MetricKind": {
      "enum": [
        "pass_completion",
        "forward_progress",
        "rhythm",
        "pressure",
        "channel",
        "receiver_separation",
        "defender_follow",
        "off_ball_run",
        "contribution"
      ]
    },
    "MomentPattern": { "enum": ["space_creation", "press_turnover", "switch_escape", "shot", "generic"] },
    "ClaimStatus": {
      "enum": ["verified_fact", "interpretation_supported", "insufficient_data", "fallback_template"]
    },
    "AnnotationId": {
      "type": "string",
      "pattern": "^(highlight|path|pressure_ring)_(blue|amber)_[0-9]{2}$|^show_channel_[0-9]{4,}$"
    }
  }
}
