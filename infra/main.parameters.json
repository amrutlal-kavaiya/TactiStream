{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "foundryResourceGroup": {
      "value": "${FOUNDRY_RESOURCE_GROUP}"
    },
    "foundryAccountName": {
      "value": "${FOUNDRY_ACCOUNT_NAME}"
    },
    "foundryProjectEndpoint": {
      "value": "${FOUNDRY_PROJECT_ENDPOINT}"
    },
    "foundryModelDeployment": {
      "value": "${FOUNDRY_MODEL_DEPLOYMENT}"
    },
    "alertEmail": {
      "value": "${ALERT_EMAIL}"
    },
    "imageName": {
      "value": "${SERVICE_WEB_IMAGE_NAME=}"
    }
  }
}
